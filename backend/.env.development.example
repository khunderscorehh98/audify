# Copy to .env.development for local work. Uses typed sign-in and local files
# instead of Firebase and R2. The server refuses AUTH_MODE=dev in production.
NODE_ENV=development
AUTH_MODE=dev
PORT=3000
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
PROCESSOR_SERVICE_TOKEN=dev-service-token
CORS_ORIGIN=http://localhost:5173
# Your email: MusicBrainz requires contact details for Autocomplete
MUSICBRAINZ_CONTACT=

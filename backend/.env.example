# Production values live in /etc/audify/backend.env (chmod 600), never in the repo.
NODE_ENV=production
PORT=3000
DB_HOST=127.0.0.1
DB_NAME=music_app
DB_USER=audify
DB_PASSWORD=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=/etc/audify/firebase-service-account.json
ADMIN_BOOTSTRAP_EMAIL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BACKUP_BUCKET=
CORS_ORIGIN=https://YOUR_PROJECT.web.app
# openssl rand -hex 32
PROCESSOR_SERVICE_TOKEN=
# Fine-grained PAT, this repo only
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=owner/repo
# Your email or site: MusicBrainz requires contact details
MUSICBRAINZ_CONTACT=
# Optional, shown with their defaults
PROCESSOR_MAX_ATTEMPTS=3
PROCESSOR_CLAIM_TIMEOUT_MIN=30
PLAY_CLOCK_SKEW_MIN=5
UPLOAD_ABANDON_HOURS=24
